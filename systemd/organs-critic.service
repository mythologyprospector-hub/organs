[Unit]
Description=Organs Critic — deterministic risk classification, stateless
After=network.target organs-registry.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/critic
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/critic/critic.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8007
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
