# Optional. Copy to /srv/organs/sandbox/sandbox.env if needed.

# SANDBOX_BASE_URL=http://localhost:8006
# SANDBOX_DEFAULT_TIMEOUT=60
# SANDBOX_MAX_TIMEOUT=300
# SANDBOX_DEFAULT_MEMORY=512m
# SANDBOX_DEFAULT_CPUS=1.0
# SANDBOX_MAX_FILES=50
# SANDBOX_MAX_TOTAL_BYTES=2000000
# SANDBOX_WORKSPACE_ROOT=/srv/organs/sandbox/workspaces
# ORGAN_REGISTRY_URL=http://localhost:8000

# Cross-boundary note: this is a user-scope systemd unit, so it can't
# meaningfully declare After=docker.service (a system-scope unit) —
# same reason Memory doesn't declare After=ollama.service. If Docker
# isn't up yet when Sandbox starts, /health will honestly report it as
# degraded until Docker comes up; jobs will fail cleanly (exit_code 127)
# rather than hang.
