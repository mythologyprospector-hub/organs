# Optional. Copy to /srv/organs/memory/memory.env and uncomment what you
# need — the unit file loads it if present (EnvironmentFile=- means it's
# fine if this doesn't exist at all).

# LLAMA_MEMORY_DIR=/srv/organs/memory/data
# OLLAMA_HOST=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
# CONSOLIDATE_MODEL=llama3.1:8b
# SALIENCE_HALF_LIFE_DAYS=30
# CONFIDENCE_HALF_LIFE_DAYS=90
# PRUNE_DEFAULT_THRESHOLD=0.15
# PRUNE_MIN_AGE_DAYS=7
# MEMORY_BASE_URL=http://localhost:8001
# ORGAN_REGISTRY_URL=http://localhost:8000
