# Optional. Copy to /srv/organs/reflection/reflection.env if needed.

# REFLECTION_STATE_PATH=/srv/organs/reflection/state.json
# REFLECTION_HISTORY_PATH=/srv/organs/reflection/history.jsonl
# REFLECTION_BASE_URL=http://localhost:8004
# OLLAMA_HOST=http://localhost:11434
# ORGAN_REGISTRY_URL=http://localhost:8000

# The service running is NOT the same as it actively thinking — it's
# OFF by default (state.json's "enabled" starts false) regardless of
# whether the systemd unit is running. Toggle it with:
#   curl -X POST localhost:8004/reflection/enable
#   curl -X POST localhost:8004/reflection/disable
# Check what it's doing with:
#   curl localhost:8004/reflection/status
#   curl localhost:8004/reflection/history
