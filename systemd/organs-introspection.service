[Unit]
Description=Organs Introspection — the machine's live self-knowledge
After=network.target organs-registry.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/introspection
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/introspection/introspection.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8005
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
