[Unit]
Description=Organs Registry — the organ directory
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/organs/registry
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/registry/registry.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
