[Unit]
Description=Organs Reflection — background self-reflection (OFF by default, toggle via API)
After=network.target organs-registry.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/reflection
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/reflection/reflection.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8004
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
