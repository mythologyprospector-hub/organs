# Optional. Copy to /srv/organs/sensei/sensei.env if needed.

# SENSEI_STATE_PATH=/srv/organs/sensei/state.json
# SENSEI_HISTORY_PATH=/srv/organs/sensei/nudge_history.jsonl
# SENSEI_BASE_URL=http://localhost:8012
# ORGAN_REGISTRY_URL=http://localhost:8000

# The service running is NOT the same as it being allowed to interrupt
# you — it starts in "watching" mode (quiet, observing) on every boot
# and stays there until you say otherwise. Toggle it:
#
#   sensei ready      # nudges start surfacing
#   sensei mute        # back to quiet observation
#   sensei status       # check current mode
#
# or directly:
#   curl -X POST localhost:8012/sensei/mode -H 'Content-Type: application/json' -d '{"mode":"ready"}'
#   curl -X POST localhost:8012/sensei/mode -H 'Content-Type: application/json' -d '{"mode":"watching"}'
#   curl localhost:8012/sensei/status
