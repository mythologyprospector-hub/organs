[Unit]
Description=Organs Memory — layered memory organ
After=network.target organs-registry.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/memory
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/memory/memory.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
