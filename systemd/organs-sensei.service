[Unit]
Description=Organs Sensei — human-optimization organ (watching by default, toggle mode via API)
After=network.target organs-registry.service organs-communications.service organs-telemetry.service organs-memory.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/sensei
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/sensei/sensei.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8012
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
