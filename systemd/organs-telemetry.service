[Unit]
Description=Organs Telemetry — the observation layer
After=network.target organs-registry.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/telemetry
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/telemetry/telemetry.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
