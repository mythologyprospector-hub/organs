[Unit]
Description=Organs Communications — pub/sub bus + dispatch
After=network.target organs-registry.service
Wants=organs-registry.service

[Service]
Type=simple
WorkingDirectory=/srv/organs/communications
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/srv/organs/communications/communications.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
